# Zentrale lokale Konfiguration fuer Docker und den Windows-Gateway.
# Diese Datei nach .env kopieren oder Configure-ItLifecycle.ps1 ausfuehren.
# Niemals die echte .env in Git einchecken.

# Webanwendung: frei waehlbar. APP_PORT muss in der Windows-Firewall erreichbar sein.
APP_PORT=8080
APP_USERNAME=itadmin
APP_PASSWORD=BITTE-DURCH-EIN-LANGES-PASSWORT-ERSETZEN

# Verbindung vom Docker-Container zum Gateway auf demselben Windows-Server.
# Token einmal zufaellig erzeugen; Gateway und Webanwendung lesen denselben Wert hier.
MANAGEMENT_AGENT_URL=http://host.docker.internal:8788
MANAGEMENT_AGENT_TOKEN=BITTE-DURCH-EINEN-ZUFAELLIGEN-TOKEN-ERSETZEN

# Microsoft 365 / Entra App-Authentifizierung.
# Tenant ID: Entra Admin Center > Identitaet > Uebersicht > Mandanten-ID
# Client ID: Entra Admin Center > App-Registrierungen > OnBoardingApp > Anwendungs-ID
# Thumbprint: Jobserver-PowerShell: Get-ChildItem Cert:\CurrentUser\My | Format-Table Subject,Thumbprint,HasPrivateKey
# Organization: primaere *.onmicrosoft.com-Domaene unter Microsoft 365 Admin Center > Einstellungen > Domaenen
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CERT_THUMBPRINT=
M365_ORGANIZATION=
